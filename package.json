{
  "name": "dsh-prompt-optimizer",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Prompt improver for DeepSeek Harness: rewrites a draft with the selected model or a local template, then writes it back into the composer.",
  "license": "MIT",
  "scripts": {
    "check": "node test/rules-check.mjs ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kachanov-e-v/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/kachanov-e-v/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/kachanov-e-v/dsh-prompt-optimizer/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "prompt-optimizer",
    "cordis"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "test/*.mjs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
